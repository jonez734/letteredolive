#!/bin/sh
# letteredolive: the BBS shell (package "shell"). Also installed as "shell" and "bbs".
#
# The venv's python runs directly, so it finds its own site-packages. a renamed argv[0] would set
# this launcher's path, and python then drops the venv (sys.prefix falls back to /usr). The command
# name is passed as --proc-name instead. A login shell is started with a leading dash on $0 (for
# example -letteredolive), and the shell reads that to tell a login session from a typed command.
exec /var/lib/zoid6/venv/bin/python -W all -m shell --proc-name "$0" "$@"
